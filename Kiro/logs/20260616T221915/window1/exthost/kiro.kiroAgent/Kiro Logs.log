2026-06-16 22:51:23.663 [info] [Terminal] Executing command {"terminalId":2,"command":"python3 - <<'EOF'\nimport os, json, glob\nout=[]\ncache=os.path.expanduser('~/.aws/sso/cache')\nout.append('CACHE DIR: '+cache)\nif os.path.isdir(cache):\n    for f in sorted(os.listdir(cache)):\n        out.append('  file: '+f)\n# search any json under .aws and kiro dirs for codewhisperer profile arn\nroots=[os.path.expanduser('~/.aws'), os.path.expanduser('~/.local/share/kiro-cli'), os.path.expanduser('~/.kiro')]\nfound=set()\nfor r in roots:\n    for p in glob.glob(r+'/**/*', recursive=True):\n        if os.path.isfile(p) and p.endswith(('.json','.txt')):\n            try:\n                t=open(p,encoding='utf-8',errors='ignore').read()\n            except Exception:\n                continue\n            import re\n            for m in re.findall(r'arn:aws:codewhisperer:[^\"\\s\\\\]+', t):\n                found.add(m)\nout.append('PROFILE ARNS FOUND:')\nout.extend(['  '+x for x in sorted(found)] or ['  (none)'])\nopen('/home/kenshin/Github/KiroRouter/_diag.txt','w').write('\\n'.join(out))\nEOF"}
