{
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 40, // Decreased from 46 for a better balance
    "margin-top": 10,
    "margin-left": 15,
    "margin-right": 15,
    "spacing": 0, 

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "pulseaudio", "backlight", "network", "battery", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "persistent-workspaces": {
            "*": 4 
        }
    },

    "cpu": {
        "interval": 2,
        "format": "   {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": "   {used:0.1f}G"
    },

    "clock": {
        "format": "    {:%I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}  {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl -q set 1%+",
        "on-scroll-down": "brightnessctl -q set 1%-"
    },

    "pulseaudio": {
        "format": "{icon}   {volume}%",
        "format-muted": "󰝟   Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "   {essid}",
        "format-disconnected": "󰖪   Offline"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}   {capacity}%",
        "format-charging": "󱐋  {capacity}%", 
        "format-plugged": "  {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "custom/power": {
        "format": "",
        "on-click": "wlogout",
        "tooltip": false
    }
}
